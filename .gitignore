# fswiki-dev state: pgdata, the dev JWT secret, sockets
/.dev/

# nix-build output
/result
/result-*

# Python bytecode from running the modules straight out of the tree
__pycache__/
*.pyc

# pytest's own scratch
.pytest_cache/

# Coverage data. FSWIKI_COVERAGE=1 keeps its own under a temp dir, but a bare
# `pytest --cov` drops one here.
.coverage
.coverage.*
htmlcov/
